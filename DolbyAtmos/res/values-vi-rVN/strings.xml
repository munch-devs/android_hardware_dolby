    <string name="dolby_profile_dynamic_desc">Tự động thích ứng âm thanh với nội dung đang phát, bạn sẽ không cần phải chuyển đổi thủ công.</string>
    <string name="dolby_profile_video_desc">Âm thanh rộng, đắm chìm với hội thoại rõ nét, được tinh chỉnh cho phim, phim nhiều tập và video.</string>
    <string name="dolby_profile_music_desc">Âm thanh cân bằng, chi tiết với âm trầm đầy đặn hơn và không gian rộng rãi cho âm nhạc.</string>
    <string name="dolby_profile_mobility_default_desc">Nghe hàng ngày khi đang di chuyển, với hội thoại rõ nét và tiếng ồn xung quanh được kiểm soát tốt.</string>
    <string name="dolby_profile_mobility_on_the_go_desc">Được tinh chỉnh cho việc đi bộ và chạy việc vặt: giọng nói vẫn rõ ràng và âm thanh thích ứng với môi trường nhộn nhịp.</string>
    <string name="dolby_profile_mobility_commute_desc">Âm thanh đầy đặn hơn với hội thoại mạnh mẽ hơn dành cho tàu hoả, xe buýt và các chuyến đi có tiếng động cơ lớn.</string>
    <string name="dolby_profile_mobility_travel_desc">Sự kết hợp cân bằng, mở rộng dành cho các hành trình dài, chuyến bay và loa khách sạn.</string>
    <string name="dolby_profile_custom_desc">Bản phối của riêng bạn. Tinh chỉnh bộ chỉnh âm và các hiệu ứng theo ý thích.</string>
